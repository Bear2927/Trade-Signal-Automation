# StockTradingSignals Environment Variables
# Copy this to .env and fill in your values

# Discord
DISCORD_USER_TOKEN=your_discord_user_token_here
DISCORD_TARGET_CHANNEL_IDS=123456789012345678,987654321098765432
DISCORD_PREMIUM_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# Facebook Messenger
MESSENGER_TARGET_CHAT_URL=https://www.facebook.com/messages/t/your_chat_id
MESSENGER_SESSION_PATH=./fb_session
MESSENGER_HEADLESS=true
MESSENGER_PROXY=host:port:user:pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# Deduplication
DEDUP_TTL=30

# Discord Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# Social Media - Twitter/X
TWITTER_ENABLED=false
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_REFRESH_TOKEN=

# Social Media - Stocktwits
STOCKTWITS_ENABLED=false
STOCKTWITS_CLIENT_ID=
STOCKTWITS_CLIENT_SECRET=
STOCKTWITS_ACCESS_TOKEN=

# Social Media - Threads
THREADS_ENABLED=false
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_USER_ACCESS_TOKEN=

# Social Media - Reddit
REDDIT_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=

# Social Media - Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Social Media - LinkedIn
LINKEDIN_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Social Media - Email (SendGrid)
EMAIL_ENABLED=false
SENDGRID_API_KEY=
EMAIL_FROM_EMAIL=
EMAIL_SUBSCRIBER_LIST_ID=